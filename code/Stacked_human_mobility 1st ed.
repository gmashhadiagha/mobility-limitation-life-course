def clean_colname(x) -> str:
    """Make one column name safe: remove NBSP, collapse whitespace, strip."""
    s = str(x).replace("\u00A0", " ")
    s = " ".join(s.split())
    return s.strip()

def clean_columns(df: pd.DataFrame) -> pd.DataFrame:
    """Clean columns even if columns are MultiIndex (from pivot)."""
    if isinstance(df.columns, pd.MultiIndex):
        new_levels = []
        for lvl in df.columns.levels:
            new_levels.append(pd.Index([clean_colname(v) for v in lvl]))
        df.columns = df.columns.set_levels(new_levels)
    else:
        df.columns = pd.Index([clean_colname(c) for c in df.columns])
    return df

def flatten_columns(df: pd.DataFrame) -> pd.DataFrame:
    """Flatten MultiIndex columns to single strings."""
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = [
            "_".join([str(c) for c in col if str(c) != ""]).strip("_")
            for col in df.columns
        ]
    else:
        df.columns = [str(c) for c in df.columns]
    return df


