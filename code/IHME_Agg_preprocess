from pathlib import Path
import re
import pandas as pd

# =========================
# 1) SET THIS PATH
# =========================
dpath = Path(r"C:\Users\gmash\OneDrive - Cleveland State University\Desktop\Prof.B.Davis\epidemiology3\NEO_NEURO")

if not dpath.exists():
    raise FileNotFoundError(f"Folder does not exist:\n{dpath}")

files = sorted(dpath.glob("*.csv")) + sorted(dpath.glob("*.CSV"))
files = sorted(set(files))

print(f"Folder: {dpath}")
print(f"Found {len(files)} CSV files.")
if not files:
    raise FileNotFoundError("No CSV files found. Check dpath.")

print("First few files:", [f.name for f in files[:5]])

# =========================
# 2) (OPTIONAL) PAYER FROM FILENAME
# =========================
def infer_payer(fname: str) -> str:
    s = fname.upper()
    if re.search(r"MEDICARE|MDCR|MEDCR|MCARE", s):        return "MEDICARE"
    if re.search(r"MEDICAID|MCDC|MCAID", s):             return "MEDICAID"
    if re.search(r"PRIVATE|PRIV|COMMERCIAL|COM", s):     return "PRIVATE"
    if re.search(r"OUT.?OF.?POCKET|OOP", s):             return "OUT_OF_POCKET"
    return "UNKNOWN"

# =========================
# 3) READ + CONCAT
# =========================
dfs = []
for f in files:
    t = pd.read_csv(f)
    # If file already has payer column, keep it; otherwise infer from filename
    if "payer" not in t.columns:
        t["payer"] = infer_payer(f.name)
    else:
        t["payer"] = t["payer"].astype(str).str.strip()

    t["source_file"] = f.name
    dfs.append(t)

df_all = pd.concat(dfs, ignore_index=True)

print("\nColumns detected (first file):")
print(pd.read_csv(files[0], nrows=1).columns.tolist())

# =========================
# 4) RENAME TO STANDARD NAMES
# =========================
# Your file already has: cause_name, age_name, sex_name, spend_mean, spend_lower, spend_upper, age_group_years_start
# We'll standardize spend_lower -> spend_low
rename_map = {}
if "spend_lower" in df_all.columns and "spend_low" not in df_all.columns:
    rename_map["spend_lower"] = "spend_low"

df_all = df_all.rename(columns=rename_map)
if rename_map:
    print("\nApplied column renames:", rename_map)

# =========================
# 5) ENSURE AGE_ID EXISTS
# =========================
# If age_id missing, build it from age_group_years_start (best) or from age_name (fallback)
if "age_id" not in df_all.columns:
    if "age_group_years_start" in df_all.columns:
        df_all["age_id"] = pd.to_numeric(df_all["age_group_years_start"], errors="coerce")
    else:
        # fallback: attempt to extract first number from age_name like "30-34 years" -> 30
        df_all["age_id"] = (
            df_all["age_name"].astype(str)
            .str.extract(r"(\d+)", expand=False)
        )
        df_all["age_id"] = pd.to_numeric(df_all["age_id"], errors="coerce")

# =========================
# 6) VALIDATE REQUIRED COLS
# =========================
required = ["cause_name", "age_id", "age_name", "sex_name", "payer", "spend_mean"]
missing = [c for c in required if c not in df_all.columns]
if missing:
    raise ValueError(
        f"Missing required columns: {missing}\n\n"
        f"Available columns:\n{df_all.columns.tolist()}"
    )

value_cols = [c for c in ["spend_mean", "spend_low", "spend_upper"] if c in df_all.columns]

# =========================
# 7) CLEAN
# =========================
df1 = df_all.loc[:, ["cause_name","age_id","age_name","sex_name","payer"] + value_cols].copy()

for c in ["cause_name","age_name","sex_name","payer"]:
    df1[c] = df1[c].astype(str).str.strip()

df1["age_id"] = pd.to_numeric(df1["age_id"], errors="coerce")

for c in value_cols:
    df1[c] = pd.to_numeric(df1[c], errors="coerce")

df1 = df1.dropna(subset=["spend_mean", "age_id"])
df1["age_id"] = df1["age_id"].astype(int)

print(f"\nRows after cleaning: {len(df1):,}")

# =========================
# 8) AGGREGATE
# =========================
per_payer = (
    df1.groupby(["cause_name","age_id","age_name","sex_name","payer"],
                observed=True, as_index=False)[value_cols]
       .sum()
)

all_payers = (
    per_payer.groupby(["cause_name","age_id","age_name","sex_name"],
                      observed=True, as_index=False)[value_cols]
             .sum()
)
all_payers["payer"] = "ALL_PAYERS"

final_all_only = all_payers.copy()
final_with_payers = pd.concat([per_payer, all_payers], ignore_index=True)

print("\nPreview (ALL_PAYERS):")
print(final_all_only.head())

# =========================
# 9) SAVE OUTPUTS
# =========================
out_all_only = dpath / "IHME_spending_ALL_ONLY.csv"
out_with_payers = dpath / "IHME_spending_WITH_PAYERS.csv"

final_all_only.to_csv(out_all_only, index=False)
final_with_payers.to_csv(out_with_payers, index=False)

print("\nSaved:")
print(" -", out_all_only)
print(" -", out_with_payers)


