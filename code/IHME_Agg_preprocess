from pathlib import Path
import pandas as pd

# ---- input file (your ALL_ONLY file) ----
infile = Path(r"C:\Users\gmash\OneDrive - Cleveland State University\Desktop\Prof.B.Davis\epidemiology3\Neo_Neuro\IHME_spending_ALL_ONLY.csv")
if not infile.exists():
    raise FileNotFoundError(f"Not found:\n{infile}")

df = pd.read_csv(infile)

# ---- normalize sex labels ----
df["sex_name"] = df["sex_name"].astype(str).str.strip().str.upper()

# keep only MALE/FEMALE for building BOTH
df_mf = df[df["sex_name"].isin(["MALE", "FEMALE"])].copy()

# value columns present
value_cols = [c for c in ["spend_mean", "spend_low", "spend_upper"] if c in df.columns]
if "spend_mean" not in value_cols:
    raise ValueError(f"'spend_mean' not found. Columns are:\n{df.columns.tolist()}")

# ---- aggregate (in case duplicates exist) ----
keys = ["cause_name", "age_id", "age_name", "payer", "sex_name"]
mf_agg = (
    df_mf.groupby(keys, as_index=False, observed=True)[value_cols]
         .sum()
)

# ---- build BOTH = FEMALE + MALE ----
both = (
    mf_agg.groupby(["cause_name", "age_id", "age_name", "payer"], as_index=False, observed=True)[value_cols]
          .sum()
)
both["sex_name"] = "BOTH"

# ---- final: FEMALE rows + MALE rows + BOTH rows ----
final = pd.concat([mf_agg, both], ignore_index=True)

# optional: nice ordering
sex_order = {"FEMALE": 0, "MALE": 1, "BOTH": 2}
final["_sex_order"] = final["sex_name"].map(sex_order).fillna(9).astype(int)
final = final.sort_values(["cause_name", "age_id", "age_name", "payer", "_sex_order"]).drop(columns=["_sex_order"])

# ---- save ----
outfile = infile.with_name("IHME_spending_ALL_ONLY_sex_F_M_BOTH.csv")
final.to_csv(outfile, index=False)

print("Saved:", outfile)
print(final.head(10))


