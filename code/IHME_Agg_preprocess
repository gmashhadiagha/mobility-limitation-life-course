# Aggregate this file across TOC -> one row per age group (and sex)
# Uses df_first from your previous cell

import pandas as pd

df1 = df_first.copy()

# Normalize column names we need
if "age_id" not in df1.columns and "age_group_years_start" in df1.columns:
    df1 = df1.rename(columns={"age_group_years_start": "age_id"})
if "spend_low" not in df1.columns and "spend_lower" in df1.columns:
    df1 = df1.rename(columns={"spend_lower": "spend_low"})

# Ensure numeric
for c in ["spend_mean","spend_low","spend_upper"]:
    if c in df1.columns:
        df1[c] = pd.to_numeric(df1[c], errors="coerce").fillna(0.0)

# --- 1) BY AGE x SEX (sum over toc) ---
g_age_sex = (
    df1
    .groupby(["age_id","age_name","sex_name"], as_index=False)[["spend_mean","spend_low","spend_upper"]]
    .sum()
    .sort_values(["age_id","sex_name"])
)

# Pivot spend_mean for compact viewing
