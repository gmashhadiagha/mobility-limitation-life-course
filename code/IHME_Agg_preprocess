import pandas as pd

# start from the file you already loaded
df1 = df_first.copy()

# --- normalize column names we need ---
if "age_id" not in df1.columns and "age_group_years_start" in df1.columns:
    df1 = df1.rename(columns={"age_group_years_start": "age_id"})
if "spend_low" not in df1.columns and "spend_lower" in df1.columns:
    df1 = df1.rename(columns={"spend_lower": "spend_low"})

# make numeric (so sums work even if there are NaNs)
for c in ["spend_mean", "spend_low", "spend_upper"]:
    if c in df1.columns:
        df1[c] = pd.to_numeric(df1[c], errors="coerce")

# --- 1) sum over TOC -> AGE x SEX ---
by_age_sex = (
    df1.groupby(["age_id","age_name","sex_name"], as_index=False)[["spend_mean","spend_low","spend_upper"]]
       .sum(min_count=1)   # if both NaN -> stays NaN; otherwise sums available
)

# keep only Male/Female for the first part (some files might contain Unknown)
by_age_sex = by_age_sex[by_age_sex["sex_name"].isin(["Male","Female"])]

# --- 2) make the 'All' row per age (sum Male+Female) ---
all_rows = (
    by_age_sex.groupby(["age_id","age_name"], as_index=False)[["spend_mean","spend_low","spend_upper"]]
              .sum(min_count=1)
)
all_rows["sex_name"] = "All"

# --- 3) concatenate and order 3 rows per age ---
out3 = pd.concat([by_age_sex, all_rows], ignore_index=True)

# order within each age: Male, Female, All
out3["sex_name"] = pd.Categorical(out3["sex_name"], categories=["Male","Female","All"], ordered=True)
out3 = out3.sort_values(["age_id","sex_name"]).reset_index(drop=True)

display(out3.head(15))  # preview first few ages

# --- 4) save to Excel next to the CSV ---
out_path = first_file.with_name(first_file.stem + "_AGE_3rows_per_age.xlsx")
with pd.ExcelWriter(out_path, engine="xlsxwriter") as xw:
    out3.to_excel(xw, sheet_name="AGE_3rows", index=False)

print("Saved:", out_path)


