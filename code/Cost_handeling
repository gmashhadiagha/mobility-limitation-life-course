import pandas as pd
from pathlib import Path

# -----------------------------
# 1. Paths
# -----------------------------
input_dir = Path(r"C:\Users\gmash\Downloads")
output_dir = Path(r"C:\Users\gmash\OneDrive - Cleveland State University\Desktop\epidemiology2\payers")

# pattern for your 4 PVD payer files
pattern = "IHME_USA_HEALTH_CARE_SPENDING_CAUSE_COUNTY_2010_2019_NEURO_EPILEPSY*2019*.CSV"

# -----------------------------
# 2. Read and concatenate all 4 payers
# -----------------------------
all_dfs = []

for f in input_dir.glob(pattern):
    print("Reading:", f.name)
    df = pd.read_csv(f)

    # keep only 2019, national, United States
    df = df[
        (df["year_id"] == 2019) &
        (df["geo"] == "national") &
        (df["location_name"] == "United States")
    ]

    # we only need age, sex, and spending
    all_dfs.append(
        df[["age_group_years_start", "age_name", "sex_id", "sex_name", "spend_mean"]]
    )

# combine all payers into one dataframe
df_all = pd.concat(all_dfs, ignore_index=True)

# -----------------------------
# 3. Aggregate across ALL payers & ALL TOC
# -----------------------------
# group by age and sex; spend_mean summed over payers and toc
grouped = (
    df_all
    .groupby(["age_group_years_start", "age_name", "sex_id", "sex_name"], as_index=False)["spend_mean"]
    .sum()
)

# -----------------------------
# 4. Build Male, Female, Both tables
# -----------------------------
# Male
male = (
    grouped[grouped["sex_id"] == 1]
    [["age_group_years_start", "age_name", "spend_mean"]]
    .rename(columns={"spend_mean": "PVD_spend_all_payers"})
    .sort_values("age_group_years_start")
)

# Female
female = (
    grouped[grouped["sex_id"] == 2]
    [["age_group_years_start", "age_name", "spend_mean"]]
    .rename(columns={"spend_mean": "PVD_spend_all_payers"})
    .sort_values("age_group_years_start")
)

# Both sexes combined (Male + Female)
both = (
    grouped
    .groupby(["age_group_years_start", "age_name"], as_index=False)["spend_mean"]
    .sum()
    .rename(columns={"spend_mean": "NEURO_EPILEPSY_all_payers"})
    .sort_values("age_group_years_start")
)

# -----------------------------
# 5. Save ONE Excel file with 3 sheets
# -----------------------------
out_file = output_dir / "NEURO_EPILEPSY_2019_USA_age_all_payers.xlsx"

with pd.ExcelWriter(out_file, engine="xlsxwriter") as writer:
    both.to_excel(writer, sheet_name="Both", index=False)
    female.to_excel(writer, sheet_name="Female", index=False)
    male.to_excel(writer, sheet_name="Male", index=False)

print("Saved:", out_file)


