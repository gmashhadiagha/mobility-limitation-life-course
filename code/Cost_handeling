import pandas as pd
from pathlib import Path

# ================================
# 1. PATH TO YOUR FOLDER
# ================================
folder = Path(r"C:\Users\gmash\OneDrive - Cleveland State University\Desktop\epidemiology2\payers")

# ================================
# 2. READ ONLY SHEET "PAYER_ALL_PAYERS"
#    FROM ALL XLSX FILES
# ================================
all_data = []

for file in folder.glob("*.xlsx"):
    try:
        df = pd.read_excel(file, sheet_name="PAYER_ALL_PAYERS")
    except ValueError:
        # file doesn't have that sheet – skip it
        print(f"Sheet 'PAYER_ALL_PAYERS' not found in {file.name}, skipping")
        continue

    df.columns = [c.strip() for c in df.columns]  # clean col names
    df["source_file"] = file.name
    all_data.append(df)

# Combine all files
df_all = pd.concat(all_data, ignore_index=True)

# ================================
# 3. OPTIONAL FILTERS / SORT
# ================================

# drop rows without sex_name
if "sex_name" in df_all.columns:
    df_all = df_all[df_all["sex_name"].notna()]

# sort by sex, age, disease if those columns exist
sort_cols = [c for c in ["sex_name", "age_id", "age_name", "cause_name"] if c in df_all.columns]
if sort_cols:
    df_all = df_all.sort_values(by=sort_cols)

# ================================
# 4. WRITE NEW EXCEL:
#    ONE SHEET PER SEX (Male/Female/All)
#    WITH ALL COST COLUMNS
# ================================
output_path = folder / "ALL_PAYERS_BY_SEX_ALL_DISEASES.xlsx"

with pd.ExcelWriter(output_path, engine="xlsxwriter") as writer:
    for sex in df_all["sex_name"].unique():
        temp = df_all[df_all["sex_name"] == sex].copy()
        if sort_cols:
            temp = temp.sort_values(by=[c for c in ["age_id", "age_name", "cause_name"] if c in temp.columns])

        # safe sheet name
        if pd.isna(sex):
            sheet_name = "Unknown_Sex"
        else:
            sheet_name = str(sex).replace(" ", "_")[:140]

        # THIS WRITES ALL COLUMNS, INCLUDING ALL spend_* COST COLUMNS
        temp.to_excel(writer, sheet_name=sheet_name, index=False)

print("DONE! Saved to:", output_path)


