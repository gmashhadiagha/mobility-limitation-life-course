import pandas as pd
from pathlib import Path

# -----------------------------------
# 1. Folder with all your payer files
# -----------------------------------
folder = Path(r"C:\Users\gmash\OneDrive - Cleveland State University\Desktop\epidemiology2\payers")

all_dfs = []

for file in folder.glob("*.xlsx"):
    try:
        xls = pd.ExcelFile(file)
    except Exception as e:
        print(f"Skipping {file.name} (cannot open): {e}")
        continue

    if "PAYER_ALL_PAYERS" not in xls.sheet_names:
        # only use files that have this sheet
        continue

    df = pd.read_excel(xls, sheet_name="PAYER_ALL_PAYERS")
    df.columns = [c.strip() for c in df.columns]
    df["source_file"] = file.name
    all_dfs.append(df)

# Combine all selected files
df_all = pd.concat(all_dfs, ignore_index=True)

# -----------------------------------
# 2. Keep only BOTH SEXES ("All")
# -----------------------------------
df_all["sex_name"] = df_all["sex_name"].astype(str).str.strip()
df_all = df_all[df_all["sex_name"] == "All"].copy()

# -----------------------------------
# 3. Normalize ages & map 0–1 + 1–5 -> 0–5
# -----------------------------------
df_all["age_name"] = df_all["age_name"].astype(str)
df_all["age_name_clean"] = df_all["age_name"].str.replace("  ", " ").str.strip()

def map_age(a: str) -> str:
    a = a.replace("  ", " ").strip()
    # any variant of 0–<1 or 1–<5 -> 0–<5
    if (a.startswith("0") and "<1" in a) or (a.startswith("1") and "<5" in a):
        return "0 - <5"
    return a

df_all["age_group"] = df_all["age_name_clean"].apply(map_age)

# build an age_id for ordering
if "age_id" in df_all.columns:
    # for each age_group, use min original age_id
    age_id_map = (
        df_all.groupby("age_group")["age_id"]
              .min()
              .reset_index()
              .rename(columns={"age_id": "age_group_id"})
    )
    df_all = df_all.merge(age_id_map, on="age_group", how="left")
else:
    # if no age_id column, create order from sorted age_group names
    unique_ages = sorted(df_all["age_group"].unique())
    age_order = {age: i for i, age in enumerate(unique_ages)}
    df_all["age_group_id"] = df_all["age_group"].map(age_order)

# -----------------------------------
# 4. Aggregate & de-duplicate
# -----------------------------------
# numeric columns to sum (spend_* etc) – exclude age ids
numeric_cols = df_all.select_dtypes("number").columns.tolist()
for c in ["age_id", "age_group_id"]:
    if c in numeric_cols:
        numeric_cols.remove(c)

# group keys: all non-numeric columns but using age_group/age_group_id
group_cols = [c for c in df_all.columns if c not in numeric_cols]

# we don't want old age_name or age_name_clean as separate grouping keys
for c in ["age_name", "age_name_clean", "age_id"]:
    if c in group_cols:
        group_cols.remove(c)

# ensure our age grouping columns are in keys
for c in ["age_group", "age_group_id"]:
    if c not in group_cols:
        group_cols.append(c)

df_grouped = (
    df_all
    .groupby(group_cols, as_index=False)[numeric_cols]
    .sum()
)

# Rename age_group -> age_name, age_group_id -> age_id for output
df_grouped = df_grouped.rename(columns={"age_group": "age_name",
                                       "age_group_id": "age_id"})

# Sort nicely by age then disease
sort_cols = [c for c in ["age_id", "age_name", "cause_name"] if c in df_grouped.columns]
df_grouped = df_grouped.sort_values(sort_cols)

print("Number of unique diseases in final file:",
      df_grouped["cause_name"].nunique())

# -----------------------------------
# 5. Save ONE Excel file
# -----------------------------------
out_path = folder / "ALL_PAYER_ALL_DISEASES_AllSex_agg0to5.xlsx"
df_grouped.to_excel(out_path, index=False, sheet_name="All")

print("Saved to:", out_path)


