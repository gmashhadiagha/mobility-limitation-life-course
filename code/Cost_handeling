df["cause_name"] = df["cause_name"].str.strip()
df["payer"] = df["payer"].str.strip()
df["sex_name"] = df["sex_name"].str.strip()
df["age_name"] = df["age_name"].astype(str).str.strip()

# ---------------- Identify 0–<1 + 1–<5 ----------------
mask = df["age_name"].isin([
    "0 - <1","0-<1","0 -<1","0- <1",
    "1 - <5","1-<5","1 -<5","1- <5"
])

df_0_5 = df[mask].copy()
df_rest = df[~mask].copy()

