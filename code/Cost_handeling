import pandas as pd
from pathlib import Path

# -----------------------------------
# 1. Read ALL original payer files
# -----------------------------------
folder = Path(r"C:\Users\gmash\OneDrive - Cleveland State University\Desktop\epidemiology2\payers")

dfs = []

for file in folder.glob("*.xlsx"):
    try:
        df = pd.read_excel(file, sheet_name="PAYER_ALL_PAYERS")
    except ValueError:
        # skip files that don't have this sheet
        continue
    
    df.columns = [c.strip() for c in df.columns]
    df["source_file"] = file.name
    dfs.append(df)

df_all = pd.concat(dfs, ignore_index=True)

# -----------------------------------
# 2. Keep BOTH SEXES ONLY (sex_name == "All")
# -----------------------------------
df_all["sex_name"] = df_all["sex_name"].astype(str).str.strip()
df_all = df_all[df_all["sex_name"] == "All"].copy()

# store how many diseases before aggregation
n_before = df_all["cause_name"].nunique()
print("Unique diseases before aggregation:", n_before)

# -----------------------------------
# 3. Normalize age_name and create age_group
#    (0–<1 and 1–<5 → 0–<5, everything else unchanged)
# -----------------------------------
df_all["age_name"] = df_all["age_name"].astype(str).str.strip()

def normalize_age(age):
    a = age.replace("  ", " ").strip()
    # handle common variants
    if (a.startswith("0") and "<1" in a) or (a.startswith("1") and "<5" in a):
        return "0 - <5"
    return a

df_all["age_group"] = df_all["age_name"].apply(normalize_age)

# For a stable ordering, build an age order from the original age_id if present
if "age_id" in df_all.columns:
    df_all["age_id"] = df_all["age_id"]
else:
    df_all["age_id"] = pd.NA  # placeholder

# -----------------------------------
# 4. Aggregate & remove duplicates
#    Group by: disease + payer + sex + normalized age
# -----------------------------------
group_cols = ["cause_name", "payer", "sex_name", "age_group"]

numeric_cols = df_all.select_dtypes("number").columns.tolist()

df_final = (
    df_all
    .groupby(group_cols, as_index=False)[numeric_cols]
    .sum()
)

# recalc diseases after aggregation
n_after = df_final["cause_name"].nunique()
print("Unique diseases after aggregation:", n_after)

# -----------------------------------
# 5. Sort and save
# -----------------------------------
# if age_id exists, sort by it; otherwise by age_group text
sort_cols = []
if "age_id" in df_final.columns:
    sort_cols.append("age_id")
sort_cols += ["age_group", "cause_name"]

sort_cols = [c for c in sort_cols if c in df_final.columns]

df_final = df_final.sort_values(sort_cols)

out_path = folder / "ALL_PAYERS_BOTHSEX_agg0to5_dedup_clean.xlsx"
df_final.to_excel(out_path, index=False, sheet_name="Both_sexes")

print("Saved to:", out_path)


