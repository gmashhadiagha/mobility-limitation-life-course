import pandas as pd
from pathlib import Path

folder = Path(r"C:\Users\gmash\OneDrive - Cleveland State University\Desktop\epidemiology2\payers")

# mapping: anything that is 0–1 or 1–5 -> "0-5"
AGE_REMAP = {
    "0-1": "0-5",
    "0 to 1": "0-5",
    "0 to 1 years": "0-5",
    "1-5": "0-5",
    "1 to 5": "0-5",
    "1 to 5 years": "0-5",
}

for path in folder.glob("*.xlsx"):
    print(f"Processing: {path.name}")
    xls = pd.ExcelFile(path)

    new_sheets = {}

    for sheet in xls.sheet_names:
        df = pd.read_excel(path, sheet_name=sheet)

        # only transform sheets that have the needed columns
        needed = {"age_name", "sex_name", "spend_mean", "spend_lower", "spend_upper"}
        if not needed.issubset(df.columns):
            # keep sheet as-is
            new_sheets[sheet] = df
            continue

        # ---------- 1) remap 0–1 and 1–5 into 0–5 ----------
        df["age_name_new"] = df["age_name"].replace(AGE_REMAP)

        # ---------- 2) group by age_name (and other id columns) ----------
        group_cols = ["age_name_new", "sex_name"]
        if "cause_name" in df.columns:
            group_cols.insert(0, "cause_name")
        if "payer" in df.columns:
            group_cols.insert(1, "payer")  # after cause_name

        agg_cols = ["spend_mean", "spend_lower", "spend_upper"]

        df_agg = (
            df.groupby(group_cols, as_index=False)[agg_cols]
              .sum()
        )

        # rename age_name_new back to age_name
        df_agg = df_agg.rename(columns={"age_name_new": "age_name"})

        # ---------- 3) drop age_id if present ----------
        if "age_id" in df_agg.columns:
            df_agg = df_agg.drop(columns=["age_id"])

        new_sheets[sheet] = df_agg

    # ---------- 4) save to a NEW file ----------
    new_path = path.with_name(path.stem + "_0to5.xlsx")
    with pd.ExcelWriter(new_path, engine="xlsxwriter") as writer:
        for sheet, df_out in new_sheets.items():
            df_out.to_excel(writer, sheet_name=sheet, index=False)

    print(f"  -> saved {new_path.name}")


